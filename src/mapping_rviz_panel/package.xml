<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mapping_rviz_panel</name>
  <version>0.1.0</version>
  <description>RViz panel with one button per mapping step (LiDAR, LIO-SAM, low level, GPS, NTRIP) and one that saves the map; each step runs in its own terminal.</description>
  <maintainer email="poomtham.chaiyapoom@gmail.com">myuser</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <build_depend>qtbase5-dev</build_depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lio_sam</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
